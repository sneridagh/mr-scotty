{
  "name": "mr-scotty",
  "version": "0.0.0",
  "description": "Mr. Scotty beams content between Plone sites through plone.restapi, from a Plone Aurora control panel.",
  "main": "index.ts",
  "files": [
    "index.ts",
    "types.d.ts",
    "tsconfig.json",
    "components",
    "config",
    "helpers",
    "routes",
    "server",
    "styles",
    "locales",
    "public",
    "README.md",
    "CHANGELOG.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "license": "MIT",
  "keywords": [
    "aurora-addon",
    "aurora",
    "plone",
    "plone-restapi",
    "migration",
    "content-transfer"
  ],
  "author": "Victor Fernandez de Alba",
  "homepage": "https://github.com/sneridagh/mr-scotty#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sneridagh/mr-scotty.git"
  },
  "bugs": {
    "url": "https://github.com/sneridagh/mr-scotty/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && if command -v i18n >/dev/null 2>&1; then NODE_ENV=production i18n --addon; else echo 'Skipping i18n extraction: the @plone/scripts i18n binary is not provided by Aurora main yet.'; fi",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "dependencies": {
    "@plone/icons": "workspace:*",
    "@plone/layout": "workspace:*",
    "@plone/quanta": "workspace:*",
    "@plone/react-router": "workspace:*",
    "@plone/registry": "workspace:*",
    "react-aria-components": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "^1.60.0",
    "release-it": "^19.0.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
