{
  "name": "mr-scotty",
  "version": "1.0.0",
  "description": "Mr.Scotty takes care of beaming up and down Plone content.",
  "main": "index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "Victor Fernandez de Alba",
  "homepage": "https://github.com/collective/mr-scotty#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:collective/mr-scotty.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && if command -v i18n >/dev/null 2>&1; then NODE_ENV=production i18n --addon; else echo 'Skipping i18n extraction: the @plone/scripts i18n binary is not provided by Aurora main yet.'; fi",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "dependencies": {
    "@plone/icons": "workspace:*",
    "@plone/quanta": "workspace:*",
    "@plone/react-router": "workspace:*",
    "@plone/registry": "workspace:*",
    "react-aria-components": "catalog:",
    "react-router": "catalog:"
  },
  "peerDependencies": {
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "^1.60.0",
    "release-it": "^19.0.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
